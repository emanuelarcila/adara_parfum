# ====================================================================
# ADARA PARFUM — Plantilla de Variables de Entorno (Vite)
# ====================================================================
# Copia este archivo como '.env.local' y asigna las credenciales reales
# obtenidas desde Firebase Console (Configuración del proyecto > Tus apps).
# '.env.local' se encuentra estrictamente excluido por .gitignore.
# ====================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Lista de UIDs de Firebase Authentication con permisos administrativos (separados por comas)
VITE_ADMIN_UIDS=UID_ADMIN_1,UID_ADMIN_2,UID_ADMIN_3
